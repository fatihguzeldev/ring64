{
  "name": "ring64",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"host/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo clippy --target wasm32-unknown-unknown --lib -- -D warnings && cargo test --locked && npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
